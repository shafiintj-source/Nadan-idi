; Engine configuration file.
; Naadan Adi 3D fresh prototype. Open with Godot 4.x.
config_version=5

[application]
config/name="Naadan Adi 3D"
run/main_scene="res://scenes/prototype_arena.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=0

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
environment/defaults/default_clear_color=Color(0.035, 0.075, 0.08, 1)
